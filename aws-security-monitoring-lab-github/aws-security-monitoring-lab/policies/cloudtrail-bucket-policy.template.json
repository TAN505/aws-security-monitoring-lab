{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudTrailCheckBucket",
      "Effect": "Allow",
      "Principal": {"Service": "cloudtrail.amazonaws.com"},
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:REPLACE_REGION:REPLACE_ACCOUNT_ID:trail/security-lab-trail"
        }
      }
    },
    {
      "Sid": "CloudTrailWriteLogs",
      "Effect": "Allow",
      "Principal": {"Service": "cloudtrail.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/AWSLogs/REPLACE_ACCOUNT_ID/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:REPLACE_REGION:REPLACE_ACCOUNT_ID:trail/security-lab-trail"
        }
      }
    }
  ]
}
